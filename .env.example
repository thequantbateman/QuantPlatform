# The application boots with safe local/demo defaults and no secrets.
# Copy to .env.local for local development only. Never commit populated env files.

# Server-only assistant provider. CLOUDFLARE_API_TOKEN is a secret; the account
# ID and model name are configuration. Never expose any of them as NEXT_PUBLIC_*.
QUANT_ASSISTANT_PROVIDER=mock
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Server-only licensed market-data credentials. Leave empty to use public/demo
# fallbacks and keep the display licence explicitly unconfirmed.
TWELVE_DATA_API_KEY=
MARKET_DATA_DISPLAY_LICENSE=unconfirmed
MARKET_DATA_LICENSE_MODE=PRIVATE_BETA
ENABLE_STREAMING_MARKETS=true
ENABLE_PROVIDER_SWITCHER=true
ENABLE_HISTORICAL_MODE=true
ENABLE_MARKET_SNAPSHOTS=true
ENABLE_MARKET_DEBUG=false
ENABLE_CRYPTO_MARKETS=true
ENABLE_PREDICTION_STREAM=true
ENABLE_PREDICTION_PERSISTENCE=true
ENABLE_PREDICTION_LIVE_PERSISTENCE=true
MARKET_UI_UPDATE_MS=100
MARKET_DATA_INTEGRATION_TESTS=false
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Local validation service only. The browser client deliberately falls back to
# framework-free TypeScript pricing on any non-local hostname.
QUANT_ENGINE_URL=http://127.0.0.1:8000
